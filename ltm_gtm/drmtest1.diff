+def __get_case_cabc_1(crtc_id:int):
+    def __get_property():
+        p_gtm = OrderedDict()
+        p_gtm["gtm_mode"] = "GTM_CABC"
+        p_gtm["temporal_smooth"] = 1
+        p_gtm["Strength"] = 4
+        p_gtm["width"] = 1920
+        p_gtm["height"] = 1280
+
+        return OrderedDict([('GTM', p_gtm)])
+
+    def __get_golden():
+        # Fill golden
+        #return OrderedDict([('md5sum', '1234567')])
+        return OrderedDict()
+
+    crtc = Crtc(crtc_id, __get_property())
+
+    plane = [Plane(0, crtc, 'AR24', 1920, 1280, 60, resource = "imgseq2_f_0_ARGB8888_1920x1280.bmp"),\
+    Plane(0, crtc, 'AR24', 1920, 1280, 60, resource = "imgseq2_f_0_ARGB8888_1920x1280.bmp"),\
+    Plane(0, crtc, 'AR24', 1920, 1280, 60, resource = "imgseq2_f_0_ARGB8888_1920x1280.bmp")]
+
+    conn = [Connector(0, crtc, 'AR30', 1920, 1280, 60, golden=__get_golden())]
+
+    name_string = "{}_mode_{}_strength_{}_cabc_1".format('GTM', 1, 4)
+    frame = [DTestUnit([plane[0]], conn, __get_name(1, name_string), frameID = 0),\
+    DTestUnit([plane[1]], conn, __get_name(1, name_string), frameID = 1),\
+    DTestUnit([plane[2]], conn, __get_name(1, name_string), frameID = 2)]
+    return DTestFrameUnit(frame, __get_name(1, name_string))
+
 @dtest_unit_group('dc9400')
 def __gen(chip_info):
     return [ __get_case_normal_1(1) ] + \
