index 066ec98e..35acc997 100644
--- a/verisilicon/9x00/vs_dc_hw.c
+++ b/verisilicon/9x00/vs_dc_hw.c
@@ -4573,6 +4573,33 @@ void dc_hw_get_display_ltm2_data(struct dc_hw *hw, u8 hw_id,
 	display = (struct dc_hw_display *)vs_dc_hw_get_display(hw, hw_id);
