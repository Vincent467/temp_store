+	if (display->gtm_mode == VS_GTM_CABC) {
+		/* gtm cabc readout, wopr/sd sum are u25, avg luma is 64 * u8 */
+		ltm_readout->read_done = false;
+
+		ltm_readout->sd_sum = dc_read_immediate(
