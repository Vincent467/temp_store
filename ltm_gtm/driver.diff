+static bool gtm_config_hw(struct dc_hw *hw, u8 hw_id, bool enable, const void *data)
+{
+	const struct drm_vs_gtm *gtm = data;
+
+	if (gtm->gtm_mode == VS_GTM_CABC)
+		gtm_cabc_hw_config(hw, hw_id, enable, gtm);
+	else
+		gtm_hw_config(hw, hw_id, enable, gtm);
+
+	return true;
+}
