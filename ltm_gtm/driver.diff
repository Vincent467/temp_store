+static bool gtm_cabc_hw_config(struct dc_hw *hw, u8 hw_id, bool enable, const void *data)
+{
+	const struct drm_vs_gtm *gtm = data;
+	struct dc_hw_display *display =
+		(struct dc_hw_display *)vs_dc_hw_get_display(hw, hw_id);
+
+	if (display)
+		display->gtm_mode = enable ? VS_GTM_CABC : VS_GTM;
+
+	/* LTM total enable in shadow panel config */
+	ltm_enable_config_hw(hw, hw_id, enable, NULL);
+
+#ifdef DCREG_SH_PANEL0_LTM2_CONFIG_Address
+	u32 config = 0;
+
+	if (enable) {
+		VS_GET_PANEL01_CONFIG(hw, hw_id, config, ltm2_config);
+		config = VS_SET_FIELD(config, DCREG_SH_PANEL0_LTM2_CONFIG, COLOR_PROTECT,
+				      gtm->color_protect_enable);
+		dc_write(hw, VS_SET_PANEL01_FIELD(DCREG_SH_PANEL, hw_id, LTM2_CONFIG_Address),
+			 config);
+		VS_SET_PANEL01_CONFIG(hw, hw_id, config, ltm2_config);
+
+		/* luma coef, luma blending */
+		ltm2_luma_config_hw(hw, hw_id, gtm->gtm_luma.enable, &gtm->gtm_luma);
+
+		/* grid width/height and hist grid depth */
+		ltm2_grid_config_hw(hw, hw_id, gtm->grid_size.enable, &gtm->grid_size);
+
+		/* slice affine grid and non roi mapping way */
+		ltm2_af_slice_config_hw(hw, hw_id, gtm->af_slice.enable, &gtm->af_slice);
+
+		/* gtm affine lut, 17 entries */
+		ltm2_af_lut_config_hw(hw, hw_id, gtm->gtm_af_luts.enable, &gtm->gtm_af_luts);
+
+		/* dither table */
+		ltm2_dither_config_hw(hw, hw_id, gtm->gtm_dither.dither_enable, &gtm->gtm_dither);
+
+		/* hist enable, hist grid scale and block ratio lr */
+		ltm2_local_hist_set_config_hw(hw, hw_id, gtm->gtm_hist_set.enable,
+					      &gtm->gtm_hist_set);
+
+		/* roi config */
+		ltm2_ds_config_hw(hw, hw_id, gtm->gtm_ds.enable, &gtm->gtm_ds);
+
+		/* wopr blending and threshold */
+		ltm2_sre_wopr_config_hw(hw, hw_id, gtm->sre_wopr.blending_enable, &gtm->sre_wopr);
+
+		/* sd blending and thresholds */
+		ltm2_sre_sd_config_hw(hw, hw_id, gtm->gtm_sd.blending_enable, &gtm->gtm_sd);
+
+		/* local histogram WDMA */
+		ltm2_local_hist_get_config_hw(hw, hw_id, gtm->ltm_hist_get.enable,
+					      &gtm->ltm_hist_get);
+	}
+#endif
+	return true;
+}
