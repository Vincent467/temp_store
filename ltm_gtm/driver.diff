+			ltm_readout->avg_luma[entry_cnt] = value & 0xFF;
+			ltm_readout->avg_luma[entry_cnt + 1] = (value >> 8) & 0xFF;
+			ltm_readout->avg_luma[entry_cnt + 2] = (value >> 16) & 0xFF;
+			ltm_readout->avg_luma[entry_cnt + 3] = (value >> 24) & 0xFF;
+		}
+
+		ltm_readout->wopr_sum = dc_read_immediate(
+			hw, VS_SET_PANEL01_FIELD(DCREG_PANEL, hw_id,
+						 LTM2_AVG_WOPR_DATA_Address)) &
+				       0x1FFFFFF;
+
+		ltm_readout->read_done = true;
+		return;
+	}
+
